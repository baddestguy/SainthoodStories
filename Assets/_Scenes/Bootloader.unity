--- !u!114 &5796878823875042008
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3880219281842014769}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.45490196, g: 0.4, b: 0.29411766, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 5606a24c44e881140940ffb94e6c5514, type: 3}
    m_FontSize: 11
    m_FontStyle: 1
    m_BestFit: 0
    m_MinSize: 1
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: '"Kateri was born in the Mohawk village of Ossernenon. She contracted smallpox
    during an epidemic which scarred her face at a very young age and killed her
    entire family. She subsequently moved into the care of her uncle who was the
    chief of a Mohawk clan.


    Trouble came when she refused to marry, despite
    the many attempts by her adoptive parents. She later converted to Catholicism,
    taking a vow of chastity and pledging to marry only Jesus Christ, a decision
    that was met with disdain among her adoptive parents and neighbors.


    She
    eventually moved to a Christian native community south of Montreal, where she
    practiced a very devout lifestyle. She died at the young age of 24. Her name,
    Kateri, is the Mohawk form of Catherine, which she took from St. Catherine of
    Siena."'
